<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_fraktjakt"
            model="ir.ui.view">
        <field name="name">res.config.settings.form.fraktjakt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="delivery.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='shipping_providers']" position="after">
                <h2>Fraktjakt</h2>
                <div class="row mt16 o_settings_container" id="fraktjakt_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Connection</span>
                            <div class="text-muted">
                                Fetch your credentials from Fraktjakt's integration settings.
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="fraktjakt_consignor_id" class="col-lg-4 o_light_label"/>
                                    <field name="fraktjakt_consignor_id"/>
                                </div>
                                <div class="row">
                                    <label for="fraktjakt_consignor_key" class="col-lg-4 o_light_label"/>
                                    <field name="fraktjakt_consignor_key" password="True"/>
                                </div>
                                <div class="row">
                                    <label for="fraktjakt_test_mode" class="col-lg-4 o_light_label"/>
                                    <field name="fraktjakt_test_mode"/>
                                </div>
                                <div class="row">
                                    <label for="fraktjakt_callback_token" class="col-lg-4 o_light_label"/>
                                    <field name="fraktjakt_callback_token"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Customs and international</span>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="fraktjakt_default_export_reason" class="col-lg-4 o_light_label"/>
                                    <field name="fraktjakt_default_export_reason"/>
                                </div>
                                <div class="row">
                                    <label for="fraktjakt_eori" class="col-lg-4 o_light_label"/>
                                    <field name="fraktjakt_eori"/>
                                </div>
                                <div class="row">
                                    <label for="fraktjakt_ioss" class="col-lg-4 o_light_label"/>
                                    <field name="fraktjakt_ioss"/>
                                </div>
                                <div class="row">
                                    <label for="fraktjakt_voec" class="col-lg-4 o_light_label"/>
                                    <field name="fraktjakt_voec"/>
                                </div>
                                <div class="row">
                                    <label for="fraktjakt_gb_vat" class="col-lg-4 o_light_label"/>
                                    <field name="fraktjakt_gb_vat"/>
                                </div>
                                <div class="row">
                                    <label for="fraktjakt_mva_num" class="col-lg-4 o_light_label"/>
                                    <field name="fraktjakt_mva_num"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
