#. module: delivery_fraktjakt_returns
#: model_terms:ir.ui.view,arch_db:delivery_fraktjakt_returns.view_fraktjakt_return_wizard
msgid "Create return"
msgstr "Skapa retur"

#. module: delivery_fraktjakt_returns
#: model_terms:ir.ui.view,arch_db:delivery_fraktjakt_returns.view_fraktjakt_return_wizard
#: model_terms:ir.ui.view,arch_db:delivery_fraktjakt_returns.portal_picking_return_form
