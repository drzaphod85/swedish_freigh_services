<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Add "Request return" form to the portal/picking page -->
    <template id="portal_picking_return_form"
              inherit_id="delivery_fraktjakt_portal.portal_picking_detail">
        <xpath expr="//div[@class='mt-3']" position="after">
            <hr/>
            <h4>Request a return</h4>
            <form t-att-action="'/my/fraktjakt/return/' + str(picking.id)"
                  method="post" class="mt-2">
                <input type="hidden" name="csrf_token"
                       t-att-value="request.csrf_token()"/>
                <div class="mb-2">
                    <label for="reason">Reason</label>
                    <textarea name="reason" id="reason" rows="3"
                              class="form-control"
                              placeholder="Please tell us why you'd like to return"/>
                </div>
                <button class="btn btn-warning" type="submit">
                    Create return
                </button>
            </form>
        </xpath>
    </template>

    <template id="return_success" name="Return created">
        <t t-call="portal.portal_layout">
            <div class="container py-5">
                <div class="alert alert-success">
                    <h3>Return created</h3>
                    <p>
                        We've created a return for <t t-out="picking.name"/>.
                        The return label will be emailed to you shortly.
                    </p>
                    <a href="/my" class="btn btn-primary">Back to my account</a>
                </div>
            </div>
        </t>
    </template>

    <template id="return_failure" name="Return failed">
        <t t-call="portal.portal_layout">
            <div class="container py-5">
                <div class="alert alert-danger">
                    <h3>Something went wrong</h3>
                    <p>We couldn't create the return automatically. Please
                       contact customer service and we'll help you.</p>
                    <a href="/my" class="btn btn-secondary">Back</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
