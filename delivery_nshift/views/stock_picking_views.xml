<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_nshift" model="ir.ui.view">
        <field name="name">stock.picking.form.nshift</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="nShift"
                      invisible="not nshift_shipment_id">
                    <group>
                        <field name="nshift_shipment_id"/>
                        <field name="nshift_tracking_number"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
