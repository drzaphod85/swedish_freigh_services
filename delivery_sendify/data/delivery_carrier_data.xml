<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="product_product_sendify" model="product.product">
        <field name="name">Shipping via Sendify</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product.cat_expense"/>
        <field name="default_code">SHIP-SENDIFY</field>
        <field name="invoice_policy">order</field>
        <field name="list_price">0.0</field>
        <field name="purchase_ok" eval="False"/>
        <field name="sale_ok" eval="False"/>
    </record>

    <record id="delivery_carrier_sendify_default" model="delivery.carrier">
        <field name="name">Sendify</field>
        <field name="delivery_type">sendify</field>
        <field name="product_id" ref="product_product_sendify"/>
        <field name="active" eval="False"/>
    </record>
</odoo>
