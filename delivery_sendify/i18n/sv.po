#. module: delivery_sendify
#: model:ir.model.fields,field_description:delivery_sendify.field_res_company__sendify_api_key
#: model:ir.model.fields,field_description:delivery_sendify.field_res_config_settings__sendify_api_key
msgid "Sendify API Key"
msgstr "Sendify API-nyckel"

#. module: delivery_sendify
#: model:ir.model.fields,help:delivery_sendify.field_res_company__sendify_api_key
msgid ""
"Bearer token. Retrieved from the Sendify portal under API settings."
msgstr ""
"Bearer-token. Hämtas från Sendify-portalen under API-inställningar."

#. module: delivery_sendify
#: model:ir.model.fields,field_description:delivery_sendify.field_res_company__sendify_test_mode
#: model:ir.model.fields,field_description:delivery_sendify.field_res_config_settings__sendify_test_mode
msgid "Sendify Test Mode"
msgstr "Sendify testläge"

#. module: delivery_sendify
#: model:ir.model.fields,help:delivery_sendify.field_res_company__sendify_test_mode
msgid ""
"When enabled, calls are logged extra and no real bookings are created. "
"Test mode must also be enabled at Sendify."
msgstr ""
"När påslaget loggas anrop extra och inga riktiga bokningar görs. "
"Test-läget ska också aktiveras hos Sendify."

#. module: delivery_sendify
#: model:ir.model.fields,field_description:delivery_sendify.field_delivery_carrier__sendify_carrier_filter
msgid "Carrier Filter"
msgstr "Filtrera transportör"

#. module: delivery_sendify
#: model:ir.model.fields,help:delivery_sendify.field_delivery_carrier__sendify_carrier_filter
msgid ""
"e.g. 'postnord' or 'dhl' to limit responses in the quote API."
msgstr ""
"t.ex. 'postnord' eller 'dhl' för att begränsa svar i quote-API:et."

#. module: delivery_sendify
#: model:ir.model.fields,field_description:delivery_sendify.field_delivery_carrier__sendify_service_filter
msgid "Service Filter"
msgstr "Service-filter"

#. module: delivery_sendify
#: model:ir.model.fields,help:delivery_sendify.field_delivery_carrier__sendify_service_filter
msgid ""
"e.g. 'mypack_collect'. Leave blank for cheapest option."
msgstr ""
"t.ex. 'mypack_collect'. Lämna tomt för billigaste val."

#. module: delivery_sendify
#: model:ir.model.fields,field_description:delivery_sendify.field_stock_picking__sendify_booking_id
