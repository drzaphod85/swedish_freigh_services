<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_sendify" model="ir.ui.view">
        <field name="name">res.config.settings.form.sendify</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="delivery.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='shipping_providers']" position="after">
                <h2>Sendify</h2>
                <div class="row mt16 o_settings_container" id="sendify_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Connection</span>
                            <div class="text-muted">
                                Fetch the API key from the Sendify portal.
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="sendify_api_key" class="col-lg-4 o_light_label"/>
                                    <field name="sendify_api_key" password="True"/>
                                </div>
                                <div class="row">
                                    <label for="sendify_test_mode" class="col-lg-4 o_light_label"/>
                                    <field name="sendify_test_mode"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
