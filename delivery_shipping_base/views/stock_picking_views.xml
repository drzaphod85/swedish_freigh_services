<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_shipping_state" model="ir.ui.view">
        <field name="name">stock.picking.form.shipping_state</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='carrier_id']" position="after">
                <field name="shipping_state" readonly="1"
                       invisible="not shipping_integration"/>
                <field name="shipping_integration" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
